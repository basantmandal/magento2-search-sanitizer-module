<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <virtualType name="HK2\SearchSanitizer\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">sanitizerLogger</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">HK2\SearchSanitizer\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Magento\Search\Model\QueryFactory">
        <plugin name="hk2_search_sanitizer_plugin" type="HK2\SearchSanitizer\Plugin\SearchSanitizer"
                sortOrder="10"/>
    </type>

    <type name="HK2\SearchSanitizer\Plugin\SearchSanitizer">
        <arguments>
            <argument name="logger" xsi:type="object">HK2\SearchSanitizer\Logger\Logger</argument>
        </arguments>
    </type>

</config>